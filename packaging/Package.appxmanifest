<?xml version="1.0" encoding="utf-8"?>
<!--
  OrixNotch MSIX manifest (sideload + Microsoft Store upload).
  Identity Name / Publisher / PublisherDisplayName and Version are filled in by
  packaging/Build-Msix.ps1 (-IdentityName -Publisher -PublisherDisplayName -Version).
  For the Store, CI passes the values Partner Center shows under
  Product management > Product identity (repo variables STORE_IDENTITY_NAME,
  STORE_PUBLISHER, STORE_PUBLISHER_DISPLAY_NAME). The Store re-signs the package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap3 uap10 rescap desktop mp">
  <Identity
    Name="OrixNotch"
    Publisher="CN=OrixNotch"
    Version="0.3.0.0"
    ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="3f1d7c9e-0b2a-4e6d-9c8f-7a1b2c3d4e5f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>OrixNotch</DisplayName>
    <PublisherDisplayName>Faisal Shohag</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>OrixNotch — Your Screen, Smarter. A dynamic-island style toolbox for Windows.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="OrixNotch" Executable="OrixNotch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OrixNotch"
        Description="Your Screen, Smarter — Smoother, Faster, Smarter."
        BackgroundColor="#0B0E17"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="OrixNotch.exe" EntryPoint="Windows.FullTrustApplication">
          <!-- Enabled: Windows turns open-at-login on after the first launch; the user can switch it off in
               Task Manager or OrixNotch's settings (StartupService). -->
          <desktop:StartupTask TaskId="OrixNotchAutostart" Enabled="true" DisplayName="OrixNotch" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- Mirror Windows notifications on the notch (user grants access once). General capabilities come before rescap. -->
    <uap3:Capability Name="userNotificationListener" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

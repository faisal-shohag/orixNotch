<?xml version="1.0" encoding="utf-8"?>
<!--
  OrixNotch MSIX manifest (sideload + Microsoft Store upload).
  BEFORE STORE SUBMISSION: set Identity Name to your reserved Store name and
  Publisher to the exact Publisher ID from Partner Center
  (Account settings > Organizational profile). The Store re-signs the package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap10 rescap desktop mp">
  <Identity
    Name="OrixNotch"
    Publisher="CN=OrixNotch"
    Version="0.3.0.0"
    ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="3f1d7c9e-0b2a-4e6d-9c8f-7a1b2c3d4e5f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>OrixNotch</DisplayName>
    <PublisherDisplayName>Faisal Shohag</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>OrixNotch — Your Screen, Smarter. A dynamic-island style toolbox for Windows.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="OrixNotch" Executable="OrixNotch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OrixNotch"
        Description="Your Screen, Smarter — Smoother, Faster, Smarter."
        BackgroundColor="#0B0E17"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="OrixNotch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OrixNotchAutostart" Enabled="false" DisplayName="OrixNotch" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

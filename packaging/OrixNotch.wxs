<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    OrixNotch per-machine MSI. File list is generated by Build-Msi.ps1 into
    MsiFiles.g.wxi (one <Component> per published file, stable auto GUIDs).
    Build: pwsh packaging/Build-Msi.ps1   (runs wix build, needs the WiX tool)
    Silent install: msiexec /i OrixNotch.msi /qn
  -->
  <Package Name="OrixNotch"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Faisal Shohag"
           UpgradeCode="239535B2-DB36-4B3C-8B2A-CB20F74D39F5"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OrixNotch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="$(var.BrandIco)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Feature Id="Main" Title="OrixNotch" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
  </Package>

  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="OrixNotch" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcutsFolder" Name="OrixNotch" />
      </Directory>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <?include MsiFiles.g.wxi?>
      <Component Bitness="always64">
        <RegistryValue Root="HKLM" Key="SOFTWARE\OrixNotch" Name="Installed" Value="1" Type="integer" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Name="OrixNotch" Target="[#MainExe]"
                  Directory="AppShortcutsFolder" WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon" Advertise="no" />
        <RemoveFolder Id="AppShortcutsFolder" Directory="AppShortcutsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

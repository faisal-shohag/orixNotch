<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    OrixNotch MSI — per-user (no admin prompt), installs to %LOCALAPPDATA%\Programs\OrixNotch.
    Built by packaging/Build-Msi.ps1 (MsiFiles.g.wxi holds the published files).

    - Open at login: the installer writes the per-user Run value (removed on uninstall). The app keeps
      it in step with its "Open at login" setting afterwards (StartupService).
    - Starts OrixNotch when the install finishes. Silent installs can skip that:
        msiexec /i OrixNotch.msi /qn LAUNCHAPP=0
    - A running OrixNotch is closed before files are replaced or removed (upgrade / uninstall).
  -->
  <Package Name="OrixNotch"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Faisal Shohag"
           UpgradeCode="239535B2-DB36-4B3C-8B2A-CB20F74D39F5"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OrixNotch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="$(var.BrandIco)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/faisal-shohag/orixNotch" />
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />

    <Feature Id="Main" Title="OrixNotch" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Close a running OrixNotch so its exe can be replaced or removed. Runs before InstallValidate,
         i.e. before Windows Installer's "files in use" check would stop the upgrade with a dialog. -->
    <SetProperty Id="CloseOrixNotch" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM OrixNotch.exe"
                 Before="CloseOrixNotch" Sequence="execute" />
    <CustomAction Id="CloseOrixNotch" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate" Return="ignore" />

    <!-- Start the app once the install is done (runs as the user; not on uninstall). -->
    <CustomAction Id="LaunchApp" FileRef="MainExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" Execute="immediate" />
    <InstallExecuteSequence>
      <Custom Action="CloseOrixNotch" Before="InstallValidate" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="LAUNCHAPP = &quot;1&quot; AND NOT REMOVE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OrixNotch" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles">
      <!-- Per-user components use an HKCU value as their key path. -->
      <Component Id="AppBinaries" Guid="F7F051E2-3345-4233-8CD8-C74B782A0D04" Directory="INSTALLFOLDER" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\OrixNotch" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <?include MsiFiles.g.wxi?>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>

      <Component Id="StartMenu" Directory="ProgramMenuFolder" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\OrixNotch" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Name="OrixNotch" Target="[#MainExe]"
                  WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" Advertise="no" />
      </Component>

      <Component Id="OpenAtLogin" Directory="INSTALLFOLDER" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="OrixNotch"
                       Value="&quot;[INSTALLFOLDER]OrixNotch.exe&quot;" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

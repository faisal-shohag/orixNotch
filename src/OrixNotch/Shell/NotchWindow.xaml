<Window x:Class="OrixNotch.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:OrixNotch.Services"
        xmlns:hero="clr-namespace:OrixNotch.Shell"
        Title="OrixNotch"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="860" Height="600" UseLayoutRounding="True"
        Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <!-- Pill = notch silhouette (Shape) + clipped content (Body). Sizes are driven by springs in code. -->
        <Grid x:Name="Pill" VerticalAlignment="Top" HorizontalAlignment="Center" AllowDrop="True">
            <Path x:Name="Shape" Fill="{DynamicResource PillBrush}" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" />

            <Grid x:Name="Body">
                <!-- Collapsed: live activity (album art + equalizer, or timer) -->
                <Grid x:Name="CollapsedLayer" Height="32" VerticalAlignment="Top">
                    <Border x:Name="MiniArt" Width="18" Height="18" CornerRadius="5" Margin="10,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource HoverBrush}"
                            Visibility="Collapsed">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5" />
                        </Border.Clip>
                        <Grid>
                            <hero:HeroIcon Kind="MusicNote" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Art, Source={x:Static svc:NowPlayingService.Instance}}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Timer activity: mode glyph inside a radial progress ring. -->
                    <Grid x:Name="MiniTimerRing" Width="20" Height="20" Margin="13,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="2" Margin="1" />
                        <Path x:Name="MiniArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <hero:HeroIcon x:Name="MiniTimerGlyph" Kind="Bolt" Width="9" Height="9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextBrush}" />
                    </Grid>

                    <StackPanel x:Name="EqBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,12,0" Height="12" Visibility="Collapsed">
                        <Rectangle x:Name="Bar1" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Bar2" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Bar3" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Bar4" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>

                    <TextBlock x:Name="MiniTimer" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" MaxWidth="200"
                               Text="{Binding Text, Source={x:Static svc:NotchActivityService.Instance}}"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Expanded: header (title + pin) / tool / tab bar at the bottom -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Visibility="Collapsed">
                    <Grid x:Name="Header" Height="30" VerticalAlignment="Top" Margin="18,16,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="-4,0,6,0"
                                    Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed" Click="OnBackClick">
                                <hero:HeroIcon Kind="ChevronLeft" Width="17" Height="17" />
                            </Button>
                            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Keep open"
                                    Foreground="{DynamicResource SubTextBrush}" Click="OnPinClick">
                                <hero:HeroIcon x:Name="PinIcon" Kind="Pin" Width="17" Height="17" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Close"
                                    Foreground="{DynamicResource SubTextBrush}" Click="OnCloseClick" Visibility="Collapsed">
                                <hero:HeroIcon Kind="XMark" Width="17" Height="17" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ContentControl x:Name="ToolHost" Margin="0,56,0,0" Focusable="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" />

                    <Grid x:Name="TabBar" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <!-- Indicator and tabs share one centered strip, so the indicator stays aligned while the notch resizes. -->
                        <Grid x:Name="TabStrip" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="TabIndicator" Width="35" Height="28" CornerRadius="8" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{DynamicResource HoverBrush}" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabIndicatorShift" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="Tabs" Orientation="Horizontal" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

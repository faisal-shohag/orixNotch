<UserControl x:Class="OrixNotch.Tools.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- New subscription: name, price, how often, next payment -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusM}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameInput" Tag="Netflix, Spotify, Claude…" KeyDown="OnInputKeyDown" />
                <TextBox x:Name="PriceInput" Grid.Column="1" Margin="6,0,0,0" KeyDown="OnInputKeyDown" />
                <ComboBox x:Name="CycleBox" Grid.Column="2" Width="100" Height="34" Margin="6,0,0,0" />
                <TextBox x:Name="DateInput" Grid.Column="3" Margin="6,0,0,0" Tag="Renews on"
                         ToolTip="Next payment date, e.g. 5 Dec or 2026-12-05" KeyDown="OnInputKeyDown" />
                <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="Add" Height="34" Margin="6,0,0,0" Click="OnAdd" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="List" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}" FontWeight="Normal" TextWrapping="Wrap" VerticalAlignment="Center"
                       Margin="4,0,12,0" Text="Add what you pay for regularly. Renewals show on your calendar, and the notch reminds you 2 days before each one." />

            <!-- Monthly total, per currency -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="EACH MONTH" Style="{StaticResource Caps}" />
                    <StackPanel x:Name="Totals" Margin="0,4,0,0" />
                    <TextBlock x:Name="CountText" Style="{StaticResource SubText}" FontSize="11" FontWeight="Normal" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="OrixNotch.Tools.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Count on the left, Clear all on the right -->
        <Grid Margin="0,0,10,8">
            <TextBlock x:Name="Count" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Width="Auto" Height="26" HorizontalAlignment="Right"
                    Foreground="{DynamicResource SubTextBrush}" ToolTip="Delete every saved notification" Click="OnClearAll">
                <StackPanel Orientation="Horizontal" Margin="8,0,9,0">
                    <hero:HeroIcon Kind="Trash" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Text="Clear all" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center" Background="{DynamicResource Surface2Brush}">
                <hero:HeroIcon Kind="Bell" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No notifications yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptySub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" hero:SmoothScroll.IsEnabled="True">
            <StackPanel x:Name="List" Margin="0,0,10,4" />
        </ScrollViewer>

        <!-- Grab handle: drag to make the notch taller or shorter; double-click resets -->
        <Border x:Name="Grip" Grid.Row="2" Width="120" Height="12" Margin="0,4,0,-6" Background="Transparent"
                Cursor="SizeNS" ToolTip="Drag to resize · double-click to reset"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp">
            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

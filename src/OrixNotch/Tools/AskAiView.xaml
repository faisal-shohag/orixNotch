<UserControl x:Class="OrixNotch.Tools.AskAiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <hero:HeroIcon Kind="Sparkles" Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Text="Ask anything" FontSize="14" FontWeight="SemiBold" Margin="7,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="EmptySub" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,3,0,10" />
            <StackPanel x:Name="Suggestions" Orientation="Horizontal" HorizontalAlignment="Center" />
            <StackPanel x:Name="KeySetup" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed">
                <ContentControl x:Name="KeyInputHost" Focusable="False" HorizontalAlignment="Center" />
                <TextBlock x:Name="KeyHint" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"
                           Text="Get a key at console.anthropic.com → API keys. It's stored encrypted on this PC." />
            </StackPanel>
        </StackPanel>

        <!-- Conversation -->
        <Grid x:Name="ChatPanel" Visibility="Collapsed">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <StackPanel x:Name="Messages" Margin="0,0,6,6" />
            </ScrollViewer>
            <Button Style="{StaticResource RowButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                    Click="OnNewChat">
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon Kind="Refresh" Width="12" Height="12" VerticalAlignment="Center"
                                          Foreground="{DynamicResource SubTextBrush}" />
                    <TextBlock Text="New chat" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" Margin="5,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Input -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Tag="Ask anything…" Height="40" Padding="14,0" KeyDown="OnInputKeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Width="34" Height="34" Margin="8,0,0,0" Padding="0"
                    Cursor="Hand" Focusable="False" Click="OnSend">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="{DynamicResource TextBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <hero:HeroIcon x:Name="SendIcon" Kind="ArrowUp" Width="15" Height="15" Foreground="{DynamicResource PillBrush}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="OrixNotch.Tools.AskAiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <!-- Round composer button (send / new chat); fill comes from Background. -->
        <ControlTemplate x:Key="RoundButton" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: shown once there's a conversation to clear -->
        <Button x:Name="NewChatButton" Style="{StaticResource IconButton}" Width="Auto" Height="24" Margin="0,0,10,4"
                HorizontalAlignment="Right" Foreground="{DynamicResource SubTextBrush}"
                ToolTip="New chat (Ctrl+N)" Click="OnNewChat" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="7,0,8,0">
                <hero:HeroIcon Kind="Plus" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="New chat" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center" Background="{DynamicResource Surface2Brush}">
                <ContentControl x:Name="EmptyLogo" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="How can I help?" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptySub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,10" />
            <StackPanel x:Name="Suggestions" Orientation="Horizontal" HorizontalAlignment="Center" />
            <StackPanel x:Name="KeySetup" HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed">
                <ContentControl x:Name="KeyInputHost" Focusable="False" HorizontalAlignment="Center" />
                <TextBlock x:Name="KeyHint" Style="{StaticResource SubText}" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"
                           Text="Get a key at console.anthropic.com → API keys. It's stored encrypted on this PC." />
            </StackPanel>
        </StackPanel>

        <!-- Conversation -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                      hero:SmoothScroll.IsEnabled="True">
            <StackPanel x:Name="Messages" Margin="0,0,10,4" />
        </ScrollViewer>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Tag="Ask anything…" Height="40" Padding="14,0" KeyDown="OnInputKeyDown" TextChanged="OnInputChanged" />
            <Button x:Name="SendButton" Grid.Column="1" Width="34" Height="34" Margin="8,0,0,0" Padding="0" Cursor="Hand" Focusable="False"
                    Template="{StaticResource RoundButton}" Background="{DynamicResource AccentBrush}"
                    ToolTip="Send (Enter)" Click="OnSend" IsEnabled="False">
                <hero:HeroIcon x:Name="SendIcon" Kind="ArrowUp" Width="15" Height="15" Foreground="{DynamicResource OnAccentBrush}" />
            </Button>
        </Grid>

        <!-- Grab handle: drag to make the chat taller or shorter; double-click resets -->
        <Border x:Name="Grip" Grid.Row="3" Width="120" Height="12" Margin="0,4,0,-6" Background="Transparent"
                Cursor="SizeNS" ToolTip="Drag to resize · double-click to reset"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp">
            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

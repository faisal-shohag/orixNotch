<UserControl x:Class="OrixNotch.Tools.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Style="{StaticResource SubText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Drag out · double-click to open" Style="{StaticResource SubText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Clear" Click="OnClear" Height="24" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Rectangle x:Name="DropOutline" RadiusX="12" RadiusY="12" Stroke="{DynamicResource TrackBrush}"
                           StrokeThickness="1.2" StrokeDashArray="5 4" />
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <hero:HeroIcon Kind="ArchiveBox" Width="26" Height="26" HorizontalAlignment="Center"
                                          Foreground="{DynamicResource SubTextBrush}" />
                    <TextBlock Text="Drop files or text onto the notch" Style="{StaticResource SubText}" Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile" Width="74" Height="82" Margin="2" CornerRadius="9" Background="Transparent"
                                        Cursor="Hand" ToolTip="{Binding Path}"
                                        PreviewMouseLeftButtonDown="OnItemMouseDown" MouseMove="OnItemMouseMove">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="OnOpen" />
                                            <MenuItem Header="Show in folder" Click="OnReveal" />
                                            <MenuItem Header="Copy" Click="OnCopy" />
                                            <MenuItem Header="Remove from shelf" Click="OnRemove" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <StackPanel Margin="4,9,4,4">
                                            <Grid Width="34" Height="34">
                                                <hero:HeroIcon x:Name="Glyph" Kind="File" Width="28" Height="28"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource SubTextBrush}" />
                                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="27" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Button x:Name="RemoveBtn" Style="{StaticResource IconButton}" Width="20" Height="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                Background="{DynamicResource HoverBrush}" Visibility="Hidden" Click="OnRemove">
                                            <hero:HeroIcon Kind="XMark" Width="11" Height="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter TargetName="Glyph" Property="Kind" Value="Folder" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

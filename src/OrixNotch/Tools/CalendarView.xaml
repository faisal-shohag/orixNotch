<UserControl x:Class="OrixNotch.Tools.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Month grid -->
        <Border Padding="4,2">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                    <TextBlock x:Name="MonthText" Style="{StaticResource Heading}" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnPrev" Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="ChevronLeft" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnToday" ToolTip="Today" Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="CalendarDays" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnNext" Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="ChevronRight" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="WeekdayRow" DockPanel.Dock="Top" Columns="7" Margin="0,2,0,0" />
                <UniformGrid x:Name="Days" Columns="7" Rows="6" />
            </DockPanel>
        </Border>

        <!-- Selected day -->
        <Grid Grid.Column="1" Margin="14,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="DayTitle" Style="{StaticResource Heading}" FontSize="15" />
                <TextBlock x:Name="DaySub" Style="{StaticResource SubText}" Margin="0,1,0,8" />
            </StackPanel>

            <TextBlock x:Name="NoEvents" Grid.Row="1" Text="No events" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource SubText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="Del" Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22"
                                            Foreground="{DynamicResource SubTextBrush}" Click="OnDelete" Visibility="Hidden">
                                        <hero:HeroIcon Kind="Trash" Width="13" Height="13" />
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimeInput" Tag="09:30" ToolTip="Time (optional), e.g. 9 or 09:30" KeyDown="OnInputKeyDown" />
                <TextBox x:Name="TitleInput" Grid.Column="1" Margin="5,0" Tag="New event" KeyDown="OnInputKeyDown" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Width="32" Height="32" Padding="0" Click="OnAdd" ToolTip="Add event">
                    <hero:HeroIcon Kind="Plus" Width="15" Height="15" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

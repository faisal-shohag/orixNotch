<UserControl x:Class="OrixNotch.Tools.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <!-- Widget card: surface fill, hairline stroke (same as Home) -->
        <Style x:Key="Widget" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Accent-soft pill button ("Today") -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource AccentSoftBrush}" CornerRadius="11" Padding="10,3,11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round accent add button -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{DynamicResource AccentBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Month card -->
        <Border x:Name="MonthCard" Style="{StaticResource Widget}" Padding="10,8,10,6">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MonthText" FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="YearText" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnPrev" ToolTip="Previous month"
                                Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="ChevronLeft" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnToday" ToolTip="Today">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="OnNext" ToolTip="Next month"
                                Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="ChevronRight" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="WeekdayRow" DockPanel.Dock="Top" Columns="7" Margin="0,0,0,2" />
                <Grid x:Name="DaysHost" ClipToBounds="False">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="DaysShift" />
                    </Grid.RenderTransform>
                    <UniformGrid x:Name="Days" Columns="7" Rows="6" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Selected day -->
        <Grid x:Name="DayPanel" Grid.Column="1" Margin="18,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Day header: big date number, weekday, month + count; Today chip when elsewhere -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DayNumber" FontSize="34" FontWeight="Light" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" MinWidth="40" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DayTitle" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="DaySub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="TodayChip" Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnToday" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <hero:HeroIcon Kind="ChevronLeft" Width="10" Height="10" VerticalAlignment="Center" />
                        <TextBlock Text="Today" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Empty state -->
            <StackPanel x:Name="NoEvents" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <hero:HeroIcon Kind="CalendarDays" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No events" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                <TextBlock Text="Add one below" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11.5" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Timeline -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" hero:SmoothScroll.IsEnabled="True">
                <ItemsControl x:Name="EventList" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Top" Margin="0,9,0,0" />

                                <!-- Node + connector line -->
                                <Grid Grid.Column="1">
                                    <Border x:Name="Line" Width="1.5" Background="{DynamicResource StrokeBrush}" Margin="0,22,0,0"
                                            HorizontalAlignment="Center" />
                                    <Ellipse x:Name="Node" Width="9" Height="9" VerticalAlignment="Top" Margin="0,12,0,0"
                                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Fill="{DynamicResource PillBrush}" />
                                </Grid>

                                <Border x:Name="Card" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="11,6,6,6" Margin="4,2,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border x:Name="NextChip" Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                                                Padding="7,1,7,2" Margin="8,0,2,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="{Binding NextLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Button x:Name="Del" Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                Foreground="{DynamicResource SubTextBrush}" Click="OnDelete" ToolTip="Delete" Visibility="Hidden">
                                            <hero:HeroIcon Kind="Trash" Width="12" Height="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TrackBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Line" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                    <Setter TargetName="NextChip" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Node" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Node" Property="Stroke" Value="{DynamicResource SubTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Time picker: clock dial over the day view. Hours first, then minutes. -->
            <Border x:Name="TimePicker" Grid.RowSpan="2" Background="{DynamicResource PillBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Canvas x:Name="Dial" Width="180" Height="180" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonDown="OnDialDown" MouseMove="OnDialMove" MouseLeftButtonUp="OnDialUp" />

                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PickHour" FontSize="38" FontWeight="Light" Cursor="Hand" Typography.NumeralAlignment="Tabular"
                                       MouseLeftButtonUp="OnPickHourMode" />
                            <TextBlock Text=":" FontSize="38" FontWeight="Light" Foreground="{DynamicResource SubTextBrush}" Margin="2,0" />
                            <TextBlock x:Name="PickMinute" FontSize="38" FontWeight="Light" Cursor="Hand" Typography.NumeralAlignment="Tabular"
                                       MouseLeftButtonUp="OnPickMinuteMode" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PickAm" Text="AM" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,4"
                                           MouseLeftButtonUp="OnPickAm" />
                                <TextBlock x:Name="PickPm" Text="PM" FontSize="12" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonUp="OnPickPm" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="PickHint" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" Margin="1,2,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Set time" Click="OnPickDone" />
                            <Button Content="All day" Margin="6,0,0,0" Click="OnPickAllDay" />
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="4,0,0,0" ToolTip="Cancel (Esc)"
                                    Foreground="{DynamicResource SubTextBrush}" Click="OnPickCancel">
                                <hero:HeroIcon Kind="XMark" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Composer: time | title | add, in one pill -->
            <Border Grid.Row="2" Margin="0,6,0,0" Height="40" CornerRadius="20" Padding="12,0,5,0"
                    Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource TrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ClockButton" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="-7,0,0,0"
                            Foreground="{DynamicResource SubTextBrush}" ToolTip="Pick a time" Click="OnPickTime">
                        <hero:HeroIcon Kind="Clock" Width="14" Height="14" />
                    </Button>
                    <TextBox x:Name="TimeInput" Grid.Column="1" Tag="Time" ToolTip="Time (optional) — type 9 or 09:30, or click to pick"
                             KeyDown="OnInputKeyDown" PreviewMouseLeftButtonUp="OnTimeInputClick"
                             Style="{StaticResource InlineField}" Padding="4,0,0,0" FontSize="13" />
                    <Border Grid.Column="2" Width="1" Height="18" Margin="4,0,2,0" Background="{DynamicResource StrokeBrush}" />
                    <TextBox x:Name="TitleInput" Grid.Column="3" Tag="New event…" KeyDown="OnInputKeyDown"
                             Style="{StaticResource InlineField}" Padding="8,0,0,0" FontSize="13" />
                    <Button Grid.Column="4" Style="{StaticResource AddButton}" Click="OnAdd" ToolTip="Add event (Enter)">
                        <hero:HeroIcon Kind="Plus" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="OrixNotch.Tools.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <!-- Segmented mode switch: dark strip, selected pill is white with dark text. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round control buttons. Primary follows the accent, secondary is the dark surface. -->
        <Style x:Key="CirclePrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Fill" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Timer | Stopwatch | Pomodoro -->
        <Border HorizontalAlignment="Center" Background="{DynamicResource Surface2Brush}"
                CornerRadius="10" Padding="3">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TimerTab" Style="{StaticResource SegmentButton}" Content="Timer" GroupName="timerMode" />
                <RadioButton x:Name="StopwatchTab" Style="{StaticResource SegmentButton}" Content="Stopwatch" GroupName="timerMode" />
                <RadioButton x:Name="PomodoroTab" Style="{StaticResource SegmentButton}" Content="Pomodoro" GroupName="timerMode" IsChecked="True" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Ring -->
            <Grid Width="118" Height="118" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource Surface2Brush}" StrokeThickness="6" Margin="2" />
                <Path x:Name="Arc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="RingText" Text="25:00" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </Grid>

            <!-- Mode info -->
            <StackPanel Grid.Column="1" Margin="18,10,12,0" VerticalAlignment="Center">
                <!-- Pomodoro -->
                <StackPanel x:Name="PomodoroInfo">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon x:Name="ModeIcon" Kind="Bolt" Width="17" Height="17"
                                             VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="ModeText" Text="Focus" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SessionText" Text="Session 1 of 4" Style="{StaticResource SubText}" Margin="0,3,0,0" />
                    <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="0,7,0,0" />
                    <TextBlock x:Name="SessionsTodayText" Text="No sessions yet today" Style="{StaticResource SubText}" Margin="0,8,0,0" FontSize="12" />
                </StackPanel>

                <!-- Timer -->
                <StackPanel x:Name="TimerInfo" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Clock" Width="17" Height="17" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Timer" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TimerPresetText" Text="10 minute countdown" Style="{StaticResource SubText}" Margin="0,3,0,0" />
                    <TextBlock Text="Stays in the closed notch." Style="{StaticResource SubText}" Margin="0,8,0,0" FontSize="12" />
                </StackPanel>

                <!-- Stopwatch -->
                <StackPanel x:Name="StopwatchInfo" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Clock" Width="17" Height="17" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Stopwatch" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LapsText" Text="No laps yet" Style="{StaticResource SubText}" Margin="0,3,0,0" />
                    <TextBlock Text="Counts up from zero." Style="{StaticResource SubText}" Margin="0,8,0,0" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" Style="{StaticResource CirclePrimaryButton}" ToolTip="Start">
                        <hero:HeroIcon x:Name="PrimaryIcon" Kind="Play" Width="19" Height="19" />
                    </Button>
                    <Button x:Name="SecondaryButton" Style="{StaticResource CircleButton}" Margin="10,0,0,0" ToolTip="Skip">
                        <hero:HeroIcon x:Name="SecondaryIcon" Kind="Forward" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="ResetButton" Style="{StaticResource CircleButton}" Margin="10,0,0,0" ToolTip="Reset">
                        <hero:HeroIcon Kind="Refresh" Width="18" Height="18" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ComboBox x:Name="DurationBox" Width="128" Height="28" FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="SoundBox" Width="118" Height="28" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

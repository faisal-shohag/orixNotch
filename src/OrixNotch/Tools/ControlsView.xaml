<UserControl x:Class="OrixNotch.Tools.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Quick toggles: filled with the accent while on. Built in code. -->
        <UniformGrid x:Name="Toggles" Rows="1" Margin="-3,0,-3,0" />

        <!-- Sound: the speakers, then every app with sound (as in Windows' volume mixer). -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,8,10,8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Speaker" Width="13" Height="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="SOUND" Style="{StaticResource Caps}" Margin="6,0,0,0" />
                    </StackPanel>
                    <Slider x:Name="MasterSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock x:Name="MasterText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel x:Name="AppList" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

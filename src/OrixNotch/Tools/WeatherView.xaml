<UserControl x:Class="OrixNotch.Tools.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,7,10,8" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="TileIcon" TargetType="hero:HeroIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The soft halo behind the condition icon: the tone's brush under a radial mask (no blur effect). -->
        <RadialGradientBrush x:Key="Halo">
            <GradientStop Color="#70000000" Offset="0" />
            <GradientStop Color="#22000000" Offset="0.55" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CityInput" Tag="City" hero:Field.Icon="MapPin" KeyDown="OnCityKeyDown"
                     ToolTip="Type a city and press Enter" />
            <TextBlock x:Name="Status" Grid.Column="1" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="10,0" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Refresh" Click="OnRefresh" Foreground="{DynamicResource SubTextBrush}">
                <hero:HeroIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </Grid>

        <Grid x:Name="CurrentPanel" Grid.Row="1" Margin="-3,5,-3,2" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Now: the condition icon glowing in its colour, the temperature, what it's like, where -->
            <Border Style="{StaticResource Tile}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64" VerticalAlignment="Center">
                        <Ellipse x:Name="CurrentHalo" Width="80" Height="80" Margin="-8" OpacityMask="{StaticResource Halo}" IsHitTestVisible="False" />
                        <hero:HeroIcon x:Name="CurrentIcon" Kind="WeatherSun" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TempText" FontSize="38" FontWeight="Light" Typography.NumeralAlignment="Tabular" Margin="0,-6,0,-2" />
                        <TextBlock x:Name="DescText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <hero:HeroIcon Kind="MapPin" Style="{StaticResource TileIcon}" Width="11" Height="11" Margin="0,0,4,0" />
                            <TextBlock x:Name="PlaceText" Style="{StaticResource SubText}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Column="1" Columns="2" Rows="2">
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <hero:HeroIcon Kind="Drop" Style="{StaticResource TileIcon}" />
                            <TextBlock Text="HUMIDITY" Style="{StaticResource Caps}" />
                        </StackPanel>
                        <hero:GlowBar x:Name="HumidityBar" Margin="0,6,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <hero:HeroIcon Kind="Wind" Style="{StaticResource TileIcon}" />
                            <TextBlock Text="WIND" Style="{StaticResource Caps}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock x:Name="WindText" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="WindSub" Style="{StaticResource SubText}" FontSize="11.5" VerticalAlignment="Center" Margin="7,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <hero:HeroIcon Kind="Thermometer" Style="{StaticResource TileIcon}" />
                            <TextBlock Text="FEELS LIKE" Style="{StaticResource Caps}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock x:Name="FeelsText" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="FeelsSub" Style="{StaticResource SubText}" FontSize="11.5" VerticalAlignment="Center" Margin="7,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <hero:HeroIcon Kind="WeatherSun" Style="{StaticResource TileIcon}" />
                                <TextBlock Text="DAYLIGHT" Style="{StaticResource Caps}" />
                            </StackPanel>
                            <TextBlock x:Name="SunTimes" Style="{StaticResource SubText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <hero:GlowBar x:Name="DaylightBar" Tone="StarBrush" Margin="0,6,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </UniformGrid>
        </Grid>

        <!-- Loading placeholder shaped like the content below; filled in code. -->
        <Grid x:Name="LoadingSkeleton" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        </Grid>

        <!-- Seven days: name, icon, low · the day's range within the week · high. Built in code. -->
        <UniformGrid x:Name="Forecast" Grid.Row="2" Rows="1" Margin="-3,0,-3,0" />
    </Grid>
</UserControl>

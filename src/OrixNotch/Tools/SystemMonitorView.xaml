<UserControl x:Class="OrixNotch.Tools.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <!-- A card: tinted icon tile + caps label (+ a quiet detail on the right), a middle line, a glowing bar. -->
        <Style x:Key="MiniCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="11,9,11,10" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileIcon" TargetType="hero:HeroIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource SubText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Mid" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Columns="3" Rows="2" Margin="-3">
        <!-- CPU: load history as a line, the current load on the bar -->
        <Border Style="{StaticResource MiniCard}">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}"><hero:HeroIcon Kind="Cpu" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CpuSub" Grid.Column="2" Style="{StaticResource Detail}" />
                </Grid>
                <hero:GlowBar x:Name="CpuBar" DockPanel.Dock="Bottom" Margin="0,4,0,0" />
                <hero:LineChart x:Name="CpuGraph" Stroke="{DynamicResource AccentBrush}" Maximum="100" Capacity="60" Margin="0,6,0,2" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}"><hero:HeroIcon Kind="Memory" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock Grid.Column="1" Text="MEMORY" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </Grid>
                <hero:GlowBar x:Name="MemBar" DockPanel.Dock="Bottom" Margin="0,4,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="MemText" Style="{StaticResource Mid}" Text="–" />
                    <TextBlock x:Name="MemSub" Style="{StaticResource SubText}" FontSize="11" FontWeight="Normal" Text="in use" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}"><hero:HeroIcon Kind="Drive" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock x:Name="DiskLabel" Grid.Column="1" Text="DISK" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </Grid>
                <hero:GlowBar x:Name="DiskBar" DockPanel.Dock="Bottom" Margin="0,4,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DiskText" Style="{StaticResource Mid}" Text="–" />
                    <TextBlock x:Name="DiskSub" Style="{StaticResource SubText}" FontSize="11" FontWeight="Normal" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Network: down and up, each with its last half-minute as a line -->
        <Border Style="{StaticResource MiniCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}"><hero:HeroIcon Kind="Wifi" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock Grid.Column="1" Text="NETWORK" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,6,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="78" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <hero:HeroIcon Kind="ArrowDown" Width="12" Height="12" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DownText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" Text="–" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    <hero:LineChart x:Name="DownGraph" Grid.Column="2" Height="18" Capacity="30" Stroke="{DynamicResource GoodBrush}" Margin="4,2,0,2" />
                    <hero:HeroIcon Grid.Row="1" Kind="ArrowUp" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpText" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" Text="–" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    <hero:LineChart x:Name="UpGraph" Grid.Row="1" Grid.Column="2" Height="18" Capacity="30" Stroke="{DynamicResource AccentBrush}" Margin="4,2,0,2" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border x:Name="BatteryTile" Style="{StaticResource Tile}"><hero:HeroIcon x:Name="BatteryIcon" Kind="BatteryFull" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock Grid.Column="1" Text="BATTERY" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </Grid>
                <hero:GlowBar x:Name="BatteryBar" DockPanel.Dock="Bottom" Margin="0,4,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryText" Style="{StaticResource Mid}" Text="–" />
                    <TextBlock x:Name="BatterySub" Style="{StaticResource SubText}" FontSize="11" FontWeight="Normal" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The busiest apps by CPU; click one to end it (asks first). -->
        <Border Style="{StaticResource MiniCard}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}"><hero:HeroIcon Kind="Fire" Style="{StaticResource TileIcon}" /></Border>
                    <TextBlock Grid.Column="1" Text="TOP APPS" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                </Grid>
                <!-- Rows are placed by code and glide between positions (fixed height: three rows). -->
                <Grid x:Name="TopApps" Margin="0,5,0,0" Height="66" VerticalAlignment="Center" ClipToBounds="True" />
            </DockPanel>
        </Border>
    </UniformGrid>
</UserControl>

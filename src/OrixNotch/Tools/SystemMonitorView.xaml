<UserControl x:Class="OrixNotch.Tools.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,1" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="LabelIcon" TargetType="hero:HeroIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="MiniCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Columns="3" Rows="2" Margin="-3">
        <Border Style="{StaticResource MiniCard}">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <hero:HeroIcon Kind="Cpu" Style="{StaticResource LabelIcon}" />
                        <TextBlock Text="CPU" Style="{StaticResource Caps}" />
                    </StackPanel>
                    <TextBlock x:Name="CpuText" Style="{StaticResource Big}" Text="–" />
                    <TextBlock x:Name="CpuSub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" />
                </StackPanel>
                <Polyline x:Name="CpuGraph" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                          VerticalAlignment="Bottom" Height="26" StrokeLineJoin="Round" Opacity="0.9" />
            </Grid>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon Kind="Memory" Style="{StaticResource LabelIcon}" />
                    <TextBlock Text="MEMORY" Style="{StaticResource Caps}" />
                </StackPanel>
                <TextBlock x:Name="MemText" Style="{StaticResource Big}" Text="–" />
                <TextBlock x:Name="MemSub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" />
                <ProgressBar x:Name="MemBar" Maximum="100" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon Kind="Drive" Style="{StaticResource LabelIcon}" />
                    <TextBlock x:Name="DiskLabel" Text="DISK" Style="{StaticResource Caps}" />
                </StackPanel>
                <TextBlock x:Name="DiskText" Style="{StaticResource Big}" Text="–" />
                <TextBlock x:Name="DiskSub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" />
                <ProgressBar x:Name="DiskBar" Maximum="100" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon Kind="Wifi" Style="{StaticResource LabelIcon}" />
                    <TextBlock Text="NETWORK" Style="{StaticResource Caps}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <hero:HeroIcon Kind="ArrowDown" Width="13" Height="13" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DownText" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0" Text="–" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <hero:HeroIcon Kind="ArrowUp" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpText" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0" Text="–" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon x:Name="BatteryIcon" Kind="BatteryFull" Style="{StaticResource LabelIcon}" />
                    <TextBlock Text="BATTERY" Style="{StaticResource Caps}" />
                </StackPanel>
                <TextBlock x:Name="BatteryText" Style="{StaticResource Big}" Text="–" />
                <TextBlock x:Name="BatterySub" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" />
                <ProgressBar x:Name="BatteryBar" Maximum="100" Margin="0,8,0,0" Foreground="{DynamicResource GoodBrush}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource MiniCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <hero:HeroIcon Kind="Clock" Style="{StaticResource LabelIcon}" />
                    <TextBlock Text="UPTIME" Style="{StaticResource Caps}" />
                </StackPanel>
                <TextBlock x:Name="UptimeText" Style="{StaticResource Big}" Text="–" />
                <TextBlock x:Name="MachineText" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>

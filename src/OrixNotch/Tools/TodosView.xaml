<UserControl x:Class="OrixNotch.Tools.TodosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <!-- Thin round check; fills with the accent when done -->
        <Style x:Key="RoundCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" Opacity="0.8" />
                            <Ellipse x:Name="Fill" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            <hero:HeroIcon x:Name="Tick" Kind="Check" Width="10" Height="10" Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter tab: plain text; the active one is full-strength with a short accent rule beneath -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="todoFilter" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="0,0,0,7" />
                            <Border x:Name="Rule" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                    Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Rule" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Count after a tab label -->
        <Style x:Key="TabCount" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters + clear, over a hairline -->
        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource StrokeBrush}" />
        <Grid>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" Style="{StaticResource FilterTab}" IsChecked="True" Checked="OnFilter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All" />
                        <TextBlock x:Name="CountAll" Style="{StaticResource TabCount}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterOpen" Style="{StaticResource FilterTab}" Checked="OnFilter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open" />
                        <TextBlock x:Name="CountOpen" Style="{StaticResource TabCount}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterStarred" Style="{StaticResource FilterTab}" Checked="OnFilter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Starred" />
                        <TextBlock x:Name="CountStarred" Style="{StaticResource TabCount}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilterDone" Style="{StaticResource FilterTab}" Checked="OnFilter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Done" />
                        <TextBlock x:Name="CountDone" Style="{StaticResource TabCount}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <Button x:Name="ClearButton" Style="{StaticResource RowButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-5,-6,0" Click="OnClearDone">
                <TextBlock Text="Clear completed" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" />
            </Button>
        </Grid>

        <!-- New to-do: first row of the list, same geometry as an item -->
        <Grid Grid.Row="1" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hero:HeroIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
            <TextBox x:Name="Input" Grid.Column="1" Tag="New to-do" KeyDown="OnInputKeyDown" Style="{StaticResource InlineField}" />
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="28,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Input}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>

        <TextBlock x:Name="Empty" Grid.Row="2" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,10,0,0" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" hero:SmoothScroll.IsEnabled="True">
            <ItemsControl x:Name="List" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Height="36" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" FontSize="13.5" Margin="0,0,8,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button x:Name="Star" Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Foreground="{DynamicResource SubTextBrush}" ToolTip="Star" Click="OnStar" Visibility="Hidden">
                                <hero:HeroIcon Kind="Star" Width="13" Height="13" />
                            </Button>
                            <Button x:Name="Del" Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Foreground="{DynamicResource SubTextBrush}" ToolTip="Delete" Click="OnDelete" Visibility="Hidden">
                                <hero:HeroIcon Kind="XMark" Width="12" Height="12" />
                            </Button>
                            <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Margin="28,0,0,0" Background="{DynamicResource StrokeBrush}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Starred}" Value="True">
                                <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Star" Property="Foreground" Value="#FFB800" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

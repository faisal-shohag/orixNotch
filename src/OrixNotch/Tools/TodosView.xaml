<UserControl x:Class="OrixNotch.Tools.TodosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,6">
            <TextBox x:Name="Input" Tag="Add a to-do and press Enter" Padding="34,0,12,0" KeyDown="OnInputKeyDown" />
            <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" Margin="12,0,0,0"
                    BorderBrush="{DynamicResource SubTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <hero:HeroIcon Kind="Plus" Width="12" Height="12" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
            </Border>
        </Grid>

        <TextBlock x:Name="Empty" Grid.Row="1" Text="Nothing to do. Nice." Style="{StaticResource SubText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="-6,0,-4,0">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="7" Padding="6,5" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Text}" FontSize="14" Margin="2,0,8,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button x:Name="Star" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                                        Foreground="{DynamicResource SubTextBrush}" ToolTip="Star" Click="OnStar">
                                    <hero:HeroIcon x:Name="StarIcon" Kind="Star" Width="14" Height="14" />
                                </Button>
                                <Button x:Name="Del" Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24"
                                        Foreground="{DynamicResource SubTextBrush}" ToolTip="Delete" Click="OnDelete" Visibility="Hidden">
                                    <hero:HeroIcon Kind="Trash" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Starred}" Value="True">
                                <Setter TargetName="Star" Property="Foreground" Value="#FFC233" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="Summary" Style="{StaticResource SubText}" VerticalAlignment="Center" />
            <Button Content="Clear completed" HorizontalAlignment="Right" Height="22" Click="OnClearDone" />
        </Grid>
    </Grid>
</UserControl>

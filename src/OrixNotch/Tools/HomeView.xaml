<UserControl x:Class="OrixNotch.Tools.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:OrixNotch.Services"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Greeting -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Grid Width="28" Height="28" Cursor="Hand" ToolTip="Change profile picture" MouseLeftButtonUp="OnAvatarClick">
                <Ellipse Fill="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="Initial" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="AvatarImage" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Greeting" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="DateLine" Style="{StaticResource SubText}" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Now Playing card; background tinted from the album art -->
            <Border x:Name="Card" CornerRadius="19" Padding="15" Height="140" VerticalAlignment="Top" DataContext="{x:Static svc:NowPlayingService.Instance}"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="109" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="109" Height="109" CornerRadius="10" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,109,109" RadiusX="10" RadiusY="10" />
                        </Border.Clip>
                        <Grid>
                            <hero:HeroIcon Kind="MusicNote" Width="24" Height="24" Foreground="{DynamicResource SubTextBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Art}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="18,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ArtistLine" Style="{StaticResource SubText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    ToolTip="Open Now Playing" Foreground="{DynamicResource SubTextBrush}" Click="OnOpenNowPlaying">
                                <hero:HeroIcon Kind="Quote" Width="13" Height="13" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <ProgressBar Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Height="4" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11.5" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11.5" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsEnabled="{Binding HasSession}">
                            <Button Style="{StaticResource IconButton}" Width="36" Height="32" Command="{Binding PreviousCommand}">
                                <hero:HeroIcon Kind="Backward" Width="20" Height="20" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="40" Height="36" Margin="14,0" Command="{Binding PlayPauseCommand}">
                                <hero:HeroIcon x:Name="PlayIcon" Kind="Play" Width="24" Height="24" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="36" Height="32" Command="{Binding NextCommand}">
                                <hero:HeroIcon Kind="Forward" Width="20" Height="20" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Today + reminders -->
            <StackPanel Grid.Column="1" Margin="22,4,0,0">
                <Button Style="{StaticResource RowButton}" Margin="-6,-4,0,0" HorizontalAlignment="Left" Click="OnOpenCalendar">
                    <StackPanel Orientation="Horizontal">
                        <hero:HeroIcon Kind="CalendarDays" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Today" FontSize="14" FontWeight="SemiBold" Margin="6,0,4,0" />
                        <hero:HeroIcon Kind="ChevronRight" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="Events" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1,0,3">
                                <Border Width="2.5" CornerRadius="1.25" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource SubText}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoEvents" Text="No events" Style="{StaticResource SubText}" FontSize="12" Margin="0,0,0,4" />

                <Button Style="{StaticResource RowButton}" Margin="-6,2,0,0" HorizontalAlignment="Left" Click="OnOpenTodos">
                    <StackPanel Orientation="Horizontal">
                        <hero:HeroIcon Kind="ListBullet" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Reminders" FontSize="14" FontWeight="SemiBold" Margin="6,0,4,0" />
                        <hero:HeroIcon Kind="ChevronRight" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="Reminders" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Ellipse Width="12" Height="12" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" FontSize="14" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoReminders" Text="All done" Style="{StaticResource SubText}" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

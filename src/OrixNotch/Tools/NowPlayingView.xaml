<UserControl x:Class="OrixNotch.Tools.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:OrixNotch.Services"
             xmlns:hero="clr-namespace:OrixNotch.Shell"
             DataContext="{x:Static svc:NowPlayingService.Instance}">
    <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Art + track + mini progress -->
            <StackPanel VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource Surface2Brush}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                    </Border.Clip>
                    <Grid>
                        <hero:HeroIcon Kind="MusicNote" Width="22" Height="22" Foreground="{DynamicResource SubTextBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Art}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="100" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" MaxWidth="100" />
                <ProgressBar x:Name="Progress" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" Height="3"
                             Width="72" Margin="0,5,0,0" Cursor="Hand" MouseLeftButtonDown="OnSeek" />
            </StackPanel>

            <!-- Synced lyrics -->
            <Grid x:Name="LyricsPanel" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed">
                <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" IsHitTestVisible="False">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="Black" Offset="0.22" />
                            <GradientStop Color="Black" Offset="0.78" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <StackPanel x:Name="LyricsLines" Margin="0,40" />
                </ScrollViewer>
                <TextBlock Text="Lyrics from LRCLIB" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="10" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Opacity="0.7" />
            </Grid>

            <!-- Big controls when there are no lyrics -->
            <Grid x:Name="ControlsPanel" Grid.Column="1" Margin="14,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceApp}" Style="{StaticResource Caps}" />
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <TextBlock x:Name="LyricsStatus" Style="{StaticResource SubText}" Margin="0,2,0,0" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" HorizontalAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" IsEnabled="{Binding HasSession}">
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding PreviousCommand}" ToolTip="Previous">
                            <hero:HeroIcon Kind="Backward" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="38" Height="36" Margin="10,0" Command="{Binding PlayPauseCommand}">
                            <hero:HeroIcon x:Name="PlayIcon" Kind="Play" Width="21" Height="21" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding NextCommand}" ToolTip="Next">
                            <hero:HeroIcon Kind="Forward" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

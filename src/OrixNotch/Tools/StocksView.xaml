<UserControl x:Class="OrixNotch.Tools.StocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TickerInput" Tag="Add ticker, e.g. TSLA" KeyDown="OnTickerKeyDown" CharacterCasing="Upper" />
            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Width="34" Height="34" Padding="0" Margin="8,0,0,0" Click="OnAdd" ToolTip="Add (Enter)">
                <hero:HeroIcon Kind="Plus" Width="15" Height="15" />
            </Button>
            <TextBlock x:Name="Status" Grid.Column="2" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="10,0" />
            <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="Refresh" Click="OnRefresh" Foreground="{DynamicResource SubTextBrush}">
                <hero:HeroIcon Kind="Refresh" Width="14" Height="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" CornerRadius="8" Padding="10,8" Margin="0,0,0,3" Background="Transparent"
                                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StrokeBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Symbol}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SubText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Polyline Grid.Column="1" Points="{Binding Points}" Stroke="{Binding Tint}" StrokeThickness="1.3"
                                          StrokeLineJoin="Round" Height="24" Width="120" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PriceText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                    <Border Background="{Binding Tint}" CornerRadius="6" Padding="8,3" Margin="0,4,0,0"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ChangeText}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="Del" Grid.Column="3" Style="{StaticResource IconButton}" Width="20" Height="20"
                                        HorizontalAlignment="Right" Click="OnRemove" Visibility="Hidden" Foreground="{DynamicResource SubTextBrush}">
                                    <hero:HeroIcon Kind="XMark" Width="12" Height="12" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

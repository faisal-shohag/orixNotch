<UserControl x:Class="OrixNotch.Tools.TeleprompterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
        </Grid.RowDefinitions>

        <!-- Empty state -->
        <Button x:Name="Placeholder" Style="{StaticResource RowButton}" Click="OnEdit">
            <TextBlock Text="Paste or write your script" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center"
                       Foreground="{DynamicResource SubTextBrush}" />
        </Button>

        <!-- Editing -->
        <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="12,10" FontSize="14.5" Visibility="Collapsed"
                 Background="{DynamicResource SurfaceBrush}" Tag="Paste your script here." />

        <!-- Prompting -->
        <!-- Text lives in a Canvas so it is never clipped to its layout slot while it scrolls.
             Click toggles play/pause, the mouse wheel nudges the position. -->
        <Grid x:Name="Stage" Visibility="Collapsed" ClipToBounds="True" Background="Transparent" Cursor="Hand"
              SizeChanged="OnStageSizeChanged" MouseLeftButtonUp="OnStageClick" MouseWheel="OnStageWheel"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Mirror" ScaleX="1" />
            </Grid.RenderTransform>
            <!-- Scrolling moves a cached bitmap of the text with a transform: no re-layout and no
                 re-rendering of glyphs per frame. -->
            <Canvas x:Name="ScrollCanvas">
                <TextBlock x:Name="ScriptText" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium"
                           LineStackingStrategy="BlockLineHeight" Canvas.Left="24">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="Scroll" />
                    </TextBlock.RenderTransform>
                    <TextBlock.CacheMode>
                        <BitmapCache EnableClearType="False" SnapsToDevicePixels="True" />
                    </TextBlock.CacheMode>
                </TextBlock>
            </Canvas>
            <!-- Edge fades: static gradients in the notch color instead of an OpacityMask (which would
                 re-composite the moving text every frame). -->
            <Rectangle x:Name="FadeTop" VerticalAlignment="Top" Height="44" IsHitTestVisible="False" />
            <Rectangle x:Name="FadeBottom" VerticalAlignment="Bottom" Height="36" IsHitTestVisible="False" />
            <TextBlock x:Name="PausedHint" Text="Paused · click or press Space" Style="{StaticResource SubText}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EditButton" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Edit script"
                        Foreground="{DynamicResource SubTextBrush}" Click="OnEdit">
                    <hero:HeroIcon x:Name="EditIcon" Kind="Pencil" Width="14" Height="14" />
                </Button>
                <Button x:Name="PlayButton" Width="28" Height="28" Margin="8,0" Padding="0" ToolTip="Play / Pause (Space)"
                        Cursor="Hand" Focusable="False" Click="OnPlay">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="14" Background="{DynamicResource TextBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <hero:HeroIcon x:Name="PlayIcon" Kind="Play" Width="14" Height="14" Foreground="{DynamicResource PillBrush}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Restart"
                        Foreground="{DynamicResource SubTextBrush}" Click="OnRestart">
                    <hero:HeroIcon Kind="Refresh" Width="14" Height="14" />
                </Button>

                <hero:HeroIcon Kind="Signal" Width="14" Height="14" Margin="14,0,6,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SubTextBrush}" ToolTip="Speed" />
                <Slider x:Name="SpeedSlider" Width="90" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="OnSpeedChanged" />
                <hero:HeroIcon Kind="Rocket" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SubTextBrush}" />

                <hero:HeroIcon Kind="Language" Width="14" Height="14" Margin="14,0,6,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SubTextBrush}" ToolTip="Text size" />
                <Slider x:Name="SizeSlider" Width="60" Minimum="13" Maximum="34" VerticalAlignment="Center" ValueChanged="OnSizeChanged" />

                <hero:HeroIcon Kind="Sun" Width="14" Height="14" Margin="14,0,6,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SubTextBrush}" ToolTip="Background opacity" />
                <Slider x:Name="OpacitySlider" Width="70" Minimum="0.2" Maximum="1" VerticalAlignment="Center" ValueChanged="OnOpacityChanged" />

                <Button x:Name="MirrorButton" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="10,0,0,0"
                        ToolTip="Mirror text" Foreground="{DynamicResource SubTextBrush}" Click="OnMirror">
                    <hero:HeroIcon Kind="ArrowsLeftRight" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Grab handle: drag to make the prompter taller or shorter -->
        <Border x:Name="Grip" Grid.Row="2" Width="120" Height="16" Background="Transparent" VerticalAlignment="Center"
                Cursor="SizeNS" ToolTip="Drag to resize"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp">
            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

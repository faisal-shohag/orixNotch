<UserControl x:Class="OrixNotch.Tools.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
    <!-- Transparent so drops land anywhere on the tab, not only on its text. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Off: what it does and a switch -->
        <StackPanel x:Name="OffState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <hero:HeroIcon Kind="DevicePhone" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Phone transfer" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="Send files both ways between your phone and this PC over Wi-Fi, by scanning a QR code. No app needed, and nothing leaves your network." />
            <Button x:Name="TurnOnButton" Style="{StaticResource AccentButton}" Content="Turn on" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnTurnOn" />
            <TextBlock x:Name="OffWaiting" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" Margin="0,8,0,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="OffStatus" FontSize="11.5" Foreground="{DynamicResource BadBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Grid x:Name="OnState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header: who we are on the network; switch off -->
            <Grid Grid.ColumnSpan="4" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="LinkDot" Width="7" Height="7" Fill="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LinkText" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,0,10,0" />
                    <Button Style="{StaticResource IconButton}" Width="Auto" Height="24" Foreground="{DynamicResource SubTextBrush}"
                            ToolTip="Open the folder received files are saved in" Click="OnOpenFolder">
                        <StackPanel Orientation="Horizontal" Margin="7,0,8,0">
                            <hero:HeroIcon Kind="Folder" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="Received" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Turn off" Height="24" FontSize="11.5" Margin="6,0,0,0" Click="OnTurnOff" />
                </StackPanel>
            </Grid>

            <!-- Browser page QR -->
            <Border x:Name="QrCard" Grid.Row="1" Style="{StaticResource Card}" Padding="8" SizeChanged="OnQrCardSizeChanged">
                <Grid>
                    <StackPanel x:Name="QrPanel" VerticalAlignment="Center">
                        <Border Background="White" CornerRadius="8" Padding="4" Width="112" Height="112" HorizontalAlignment="Center">
                            <Image x:Name="Qr" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock Text="Scan with your phone" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="10.5"
                                   HorizontalAlignment="Center" Margin="0,7,0,0" />
                        <TextBlock x:Name="IpText" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />

                        <!-- How it works: only when the tab is tall enough to show it without crowding the code -->
                        <StackPanel x:Name="Steps" Margin="4,18,4,0" Visibility="Collapsed">
                            <Rectangle Height="1" Fill="{DynamicResource HoverBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="HOW IT WORKS" Style="{StaticResource Caps}" FontSize="9.5" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="1" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Phone on the same Wi-Fi as this PC" FontSize="10.5" TextWrapping="Wrap" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="2" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Scan the code with its camera" FontSize="10.5" TextWrapping="Wrap" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="3" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Drop files here, or send from the page" FontSize="10.5" TextWrapping="Wrap" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="QrOff" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" Text="Join the same Wi-Fi as your phone" />
                </Grid>
            </Border>

            <!-- Outbox: what the phone page offers under "From PC" -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="TO PHONE" Style="{StaticResource Caps}" FontSize="10.5" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Foreground="{DynamicResource SubTextBrush}"
                                ToolTip="Send files…" Click="OnAddFiles">
                            <hero:HeroIcon Kind="Plus" Width="12" Height="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Foreground="{DynamicResource SubTextBrush}"
                                ToolTip="Send what's on the clipboard" Click="OnSendClipboard">
                            <hero:HeroIcon Kind="ClipboardList" Width="12" Height="12" />
                        </Button>
                        <Button x:Name="ClearOutboxButton" Style="{StaticResource IconButton}" Width="22" Height="22" Foreground="{DynamicResource SubTextBrush}"
                                ToolTip="Clear the list" Click="OnClearOutbox">
                            <hero:HeroIcon Kind="Trash" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DropHint" Grid.Row="1">
                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="4 3" Stroke="{DynamicResource SubTextBrush}" Opacity="0.45" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource HoverBrush}" HorizontalAlignment="Center">
                            <hero:HeroIcon Kind="ArrowUp" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Drop files or folders here" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource SubText}" FontWeight="Normal" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="They show up on the phone page right away." />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" hero:SmoothScroll.IsEnabled="True">
                    <ItemsControl x:Name="OutboxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Background="{DynamicResource SurfaceBrush}" Padding="9,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <hero:HeroIcon x:Name="KindIcon" Kind="File" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}">
                                                <Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="4,0,0,0"
                                                VerticalAlignment="Center" ToolTip="Stop offering this" Foreground="{DynamicResource SubTextBrush}" Click="OnRemoveOutbox">
                                            <hero:HeroIcon Kind="XMark" Width="10" Height="10" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                        <Setter TargetName="KindIcon" Property="Kind" Value="Folder" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                                        <Setter TargetName="KindIcon" Property="Kind" Value="DocText" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Downloaded">
                                        <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Shown on phone">
                                        <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource GoodBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Rectangle Grid.Row="1" Grid.Column="2" Width="1" Fill="{DynamicResource HoverBrush}" Margin="0,2" />

            <!-- Activity: uploads from and downloads to the phone -->
            <Grid Grid.Row="1" Grid.Column="3" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACTIVITY" Style="{StaticResource Caps}" FontSize="10.5" Height="22" Padding="0,5,0,0" Margin="0,0,0,4" />

                <Grid Grid.Row="1">
                    <StackPanel x:Name="NoTransfers" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource HoverBrush}" HorizontalAlignment="Center">
                            <hero:HeroIcon Kind="ArrowsUpDown" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing yet" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource SubText}" FontWeight="Normal" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Files from the phone land on the Shelf and in Downloads\OrixNotch." />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" hero:SmoothScroll.IsEnabled="True">
                        <ItemsControl x:Name="TransferList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" Padding="9,6" Margin="0,0,0,4"
                                            MouseLeftButtonUp="OnTransferClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <hero:HeroIcon x:Name="Dir" Kind="ArrowDown" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,7,0"
                                                           Foreground="{DynamicResource SubTextBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubTextBrush}">
                                                    <Run Text="{Binding Direction, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                                </TextBlock>
                                                <Border x:Name="Track" Height="3" CornerRadius="1.5" Background="{DynamicResource TrackBrush}" Margin="0,4,0,1"
                                                        ClipToBounds="True">
                                                    <Border CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                            <Button x:Name="CancelBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="4,0,0,0"
                                                    VerticalAlignment="Top" ToolTip="Cancel" Foreground="{DynamicResource SubTextBrush}" Click="OnCancelTransfer">
                                                <hero:HeroIcon Kind="XMark" Width="10" Height="10" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Incoming}" Value="False">
                                            <Setter TargetName="Dir" Property="Kind" Value="ArrowUp" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="CancelBtn" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Track" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                            <Setter TargetName="Row" Property="Cursor" Value="Hand" />
                                            <Setter TargetName="Row" Property="ToolTip" Value="Show in folder" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CanOpen}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="Dir" Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Grab handle: drag to make the notch taller or shorter; double-click resets -->
        <Border x:Name="Grip" Grid.Row="1" Width="120" Height="12" Margin="0,4,0,-6" Background="Transparent"
                Cursor="SizeNS" ToolTip="Drag to resize · double-click to reset"
                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" LostMouseCapture="OnGripUp">
            <Border Width="44" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

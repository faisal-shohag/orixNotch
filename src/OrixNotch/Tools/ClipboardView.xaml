<UserControl x:Class="OrixNotch.Tools.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search + filters -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="203" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Tag="Search" hero:Field.Icon="Magnifier" hero:Field.Clearable="True"
                     TextChanged="OnSearchChanged" />
            <StackPanel x:Name="Filters" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="Status" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource GoodBrush}" />
                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="More"
                        Foreground="{DynamicResource SubTextBrush}" Click="OnMenu">
                    <hero:HeroIcon Kind="Ellipsis" Width="17" Height="17" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Clear unpinned" Click="OnClear" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Empty" Grid.Row="1" Text="Copy something — it will show up here." Style="{StaticResource SubText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Horizontal card strip -->
        <!-- Wheel glides; resting the pointer near either edge scrolls that way (EdgeScroll). -->
        <ScrollViewer x:Name="Strip" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      hero:EdgeScroll.IsEnabled="True" ScrollChanged="OnStripScrolled">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="148" Height="150" Margin="0,0,13,0" CornerRadius="10" Padding="11,10"
                                Background="{DynamicResource SurfaceBrush}" Cursor="Hand" ToolTip="Click to copy"
                                MouseLeftButtonUp="OnCardClick">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Height="20">
                                    <StackPanel Orientation="Horizontal">
                                        <hero:HeroIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource SubText}" FontSize="13" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <hero:HeroIcon x:Name="PinMark" Kind="Pin" Width="11" Height="11" Margin="4,0,0,0"
                                                              VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Hidden">
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" ToolTip="Pin"
                                                Foreground="{DynamicResource SubTextBrush}" Click="OnPin">
                                            <hero:HeroIcon Kind="Pin" Width="11" Height="11" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" ToolTip="Delete"
                                                Foreground="{DynamicResource SubTextBrush}" Click="OnDelete">
                                            <hero:HeroIcon Kind="XMark" Width="11" Height="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <TextBlock x:Name="PreviewText" Text="{Binding Preview}" FontSize="14" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                                    <StackPanel x:Name="LinkBlock" Visibility="Collapsed">
                                        <TextBlock Text="{Binding LinkHost}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LinkPath}" Style="{StaticResource SubText}" FontSize="13" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="64" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Image x:Name="Thumb" Source="{Binding Thumb}" Stretch="UniformToFill" Visibility="Collapsed">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,126,98" RadiusX="6" RadiusY="6" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasThumb}" Value="True">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Link">
                                <Setter TargetName="LinkBlock" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- "More this way" hints: fades in the notch color plus a chevron, shown only when the
             strip can scroll that way. Visual only; the pointer reaches the cards underneath. -->
        <Grid x:Name="EdgeLeft" Grid.Row="1" Width="48" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
            <Rectangle x:Name="EdgeLeftFade" />
            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Surface2Brush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                <hero:HeroIcon Kind="ChevronLeft" Width="12" Height="12" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <Grid x:Name="EdgeRight" Grid.Row="1" Width="48" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0">
            <Rectangle x:Name="EdgeRightFade" />
            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Surface2Brush}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                <hero:HeroIcon Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrixNotch</AssemblyName>
    <RootNamespace>OrixNotch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\OrixNotch.ico</ApplicationIcon>
    <Version>0.15.0</Version>
    <Product>OrixNotch</Product>
    <!-- WPF needs the DPI settings in app.manifest; the WinForms analyzer only knows SetHighDpiMode. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- The UI is English only: don't ship the 13 language folders of framework/package resources (~16 MB). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and Screen; keep its names out of global scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\emoji-test.txt" />
    <EmbeddedResource Include="Resources\phone.html" />
    <!-- The phone page's logo and home-screen icon: the same brand files the app uses. -->
    <EmbeddedResource Include="Assets\Brand\mark.svg" LogicalName="OrixNotch.Resources.mark.svg" />
    <EmbeddedResource Include="Assets\Brand\logo-512.png" LogicalName="OrixNotch.Resources.logo-512.png" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Fonts\*.CompositeFont" />
    <Resource Include="Assets\Brand\OrixNotch.ico" />
    <Resource Include="Assets\Brand\logo-512.png" />
    <Resource Include="Assets\Brand\mark.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for Phone transfer (browser page on the LAN). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
